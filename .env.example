# Database Configuration
POSTGRES_USER="halisi_user"
POSTGRES_PASSWORD="" # required: a long random password
POSTGRES_DB="halisi_db"
DATABASE_URL="postgresql://halisi_user:<POSTGRES_PASSWORD>@localhost:5432/halisi_db?schema=public"

# Auth.js / NextAuth (Generate secret via: `openssl rand -base64 32` or `npx auth secret`)
NEXTAUTH_URL="http://localhost:3000"
# Required. The app refuses to start in production without a strong value.
AUTH_SECRET=""
NEXTAUTH_SECRET="" # optional legacy alias; leave empty to use AUTH_SECRET

# Abandoned Cart Email & Cron Configuration
CRON_SECRET="" # required for /api/cron: openssl rand -hex 32
RESEND_API_KEY="re_your_resend_api_key"
FROM_EMAIL="Halisi Gifts <orders@halisigifts.com>"
# Where new-order alerts go (falls back to ADMIN_EMAIL). Leave empty to disable.
ORDER_ALERT_EMAIL="orders@halisigifts.com"

# Seed Credentials (Optional)
ADMIN_EMAIL="admin@halisigifts.com"
SEED_ADMIN_PASSWORD="" # choose a strong password (12+ chars)
CUSTOMER_EMAIL="customer@halisigifts.com"
SEED_CUSTOMER_PASSWORD=""

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Image Optimization Providers (Cloudinary / Cloudflare Images)
IMAGE_PROVIDER="next" # cloudinary | cloudflare | next
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDFLARE_IMAGES_ACCOUNT_ID=""
CLOUDFLARE_IMAGES_API_TOKEN=""

# Meta Pixel, Conversions API (CAPI) & Site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_META_PIXEL_ID=""
META_CAPI_ACCESS_TOKEN=""
META_TEST_EVENT_CODE="" # e.g. TEST12345
NEXT_PUBLIC_META_DOMAIN_VERIFICATION=""

# TikTok Pixel & Web Events API
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""
TIKTOK_EVENTS_API_ACCESS_TOKEN=""
TIKTOK_TEST_EVENT_CODE=""

# Mawimbi Gifts Real-Time Product Sync
SYNC_SECRET_KEY=""
MAWIMBI_BASE_URL="https://www.mawimbigifts.com"
