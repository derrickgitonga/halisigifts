datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum CartStatus {
  ACTIVE
  ABANDONED
  RECOVERED
  CONVERTED
}

enum OrderStatus {
  PENDING
  PROCESSING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum DeliveryMethod {
  PICKUP
  RIDER
  COURIER
}

enum PaymentMethod {
  MPESA
  CARD
  CASH_ON_DELIVERY
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  orders       Order[]
  cartSessions CartSession[]
  cartItems    CartItem[]
  reviews      Review[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  image       String?
  showInNav   Boolean    @default(false)
  navOrder    Int        @default(0)
  navLabel    String?
  parentId    String?
  parent      Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[] @relation("SubCategories")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Product {
  id             String           @id @default(cuid())
  name           String
  slug           String           @unique
  description    String           @db.Text
  price          Decimal          @default(0.00) @db.Decimal(10, 2)
  compareAtPrice Decimal?         @db.Decimal(10, 2)
  priceMin       Decimal?         @db.Decimal(10, 2)
  priceMax       Decimal?         @db.Decimal(10, 2)
  categoryId     String
  category       Category         @relation(fields: [categoryId], references: [id])
  images         String[]
  stock          Int              @default(0)
  sku            String           @unique
  isNew          Boolean          @default(false)
  isFeatured     Boolean          @default(false)
  isHotDeal      Boolean          @default(false)
  isActive       Boolean          @default(true)
  statusNote     String?
  variants       ProductVariant[]
  orderItems     OrderItem[]
  cartItems      CartItem[]
  reviews        Review[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([categoryId, isActive])
  @@index([isActive, isFeatured])
  @@index([isActive, isNew])
  @@index([isActive, isHotDeal])
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String
  image         String?
  priceModifier Decimal  @default(0.00) @db.Decimal(10, 2)
  stock         Int      @default(0)
  sku           String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([productId])
}

model Order {
  id                  String         @id @default(cuid())
  /// Customer-facing sequential number, shown as HG-10001
  orderNumber         Int            @unique @default(autoincrement())
  userId              String?
  user                User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestEmail          String?
  status              OrderStatus    @default(PENDING)
  subtotal            Decimal        @default(0.00) @db.Decimal(10, 2)
  discountAmount      Decimal        @default(0.00) @db.Decimal(10, 2)
  deliveryFee         Int            @default(0)
  engravingFee        Int            @default(0)
  total               Decimal        @db.Decimal(10, 2)
  amountDueNow        Decimal        @default(0.00) @db.Decimal(10, 2)
  amountDueOnDelivery Decimal        @default(0.00) @db.Decimal(10, 2)
  shippingAddress     Json
  paymentReference    String?
  deliveryMethod      DeliveryMethod @default(PICKUP)
  county              String?
  paymentMethod       PaymentMethod  @default(MPESA)
  items               OrderItem[]
  cartSession         CartSession?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  variantId       String?
  variantName     String?
  quantity        Int
  priceAtPurchase Decimal  @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
}

model CartItem {
  id              String       @id @default(cuid())
  sessionOrUserId String
  cartSessionId   String?
  cartSession     CartSession? @relation(fields: [cartSessionId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId       String
  product         Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId       String?
  variantName     String?
  quantity        Int          @default(1)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([sessionOrUserId])
  @@index([cartSessionId])
}

model CartSession {
  id             String      @id @default(cuid())
  sessionToken   String      @unique
  userId         String?
  user           User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  email          String?
  customerName   String?
  status         CartStatus  @default(ACTIVE)
  abandonedAt    DateTime?
  reminderCount  Int         @default(0)
  lastReminderAt DateTime?
  recoveryToken  String?     @unique
  lastActiveAt   DateTime    @default(now())
  createdAt      DateTime    @default(now())
  items          CartItem[]
  order          Order?      @relation(fields: [orderId], references: [id])
  orderId        String?     @unique

  @@index([status, reminderCount, lastActiveAt])
  @@index([email])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String   @db.Text
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

